[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/menu/death_screen.gd" id="1_death"]

[node name="DeathScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_death")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.05, 0.01, 0.01, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 200
theme_override_constants/margin_top = 120
theme_override_constants/margin_right = 200
theme_override_constants/margin_bottom = 120

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 28
alignment = 1

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.15, 0.15, 1)
theme_override_font_sizes/font_size = 40
horizontal_alignment = 1
text = "VOCÊ MORREU"

[node name="Spacer" type="Control" parent="Margin/VBox"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2

[node name="ContinuarButton" type="Button" parent="Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Continuar do último save"

[node name="MenuButton" type="Button" parent="Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Voltar ao menu inicial"

[connection signal="pressed" from="Margin/VBox/ContinuarButton" to="." method="_on_continuar_pressed"]
[connection signal="pressed" from="Margin/VBox/MenuButton" to="." method="_on_menu_pressed"]
